library(Seurat)
library(here)
library(Seurat)
library(Matrix)
library(ggplot2)
here::i_am("repo/r_scripts/load_data.R")
localdir <- here("../data")
intestine <- Load10X_Spatial(data.dir = localdir, bin.size = c(8,16))
#Extract counts from the 16um bins data:
counts <- GetAssayData(intestine, assay = "Spatial.016um", layer="counts")
counts <- t(counts)
vln <- VlnPlot(intestine)
intestine$nCount_Spatial.016um
hist(intestine$nCount_Spatial.016um, breaks=100)
#Visualize library size distribution
hist(intestine$nCount_Spatial.016um, breaks=100)
#Visualize library size distribution
hist(intestine$nCount_Spatial.008um, breaks=100)
#Visualize library size distribution
hist(intestine$nCount_Spatial.016um, breaks=100)
#Visualize library size distribution
hist(intestine$nCount_Spatial.016um, breaks=1000)
#Visualize library size distribution
hist(intestine$nCount_Spatial.016um, breaks=500)
#Visualize library size distribution
hist(intestine$nCount_Spatial.016um, breaks=200)
#Visualize library size distribution
hist(intestine$nCount_Spatial.016um, breaks=100)
#Visualize library depth distribution
hist(intestine$nCount_Spatial.016um, breaks=100,
main="Librayr depth distribution", xlab="UMIs per cell")
#Visualize library depth distribution
hist(intestine$nCount_Spatial.016um, breaks=100,
main="Library depth distribution", xlab="UMIs per cell")
Images(intestine)
intestine@images[[1]]@image
intestine@images[[1]]@scale.factors
DefaultImage(intestine) <- "hires"
GetImage(intestine)
GetImage(intestine, mode = "raw")
GetImage(intestine, mode = "plotly")
GetImage(intestine, mode = "grob")
